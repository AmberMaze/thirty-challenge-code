# Supabase project URL (https://project-name.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon public API key (found under Project Settings > API > anon)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Daily.co API key (found at https://dashboard.daily.co/developer)
DAILY_API_KEY=your-daily-api-key

# Daily.co custom domain (optional, defaults to daily.co)
# If you have a custom domain like "thirty.daily.co", set it here
# Format: subdomain.daily.co (without https://)
# Server-side (for Netlify functions)
DAILY_DOMAIN=thirty.daily.co
# Client-side (for development mode and frontend display)
VITE_DAILY_DOMAIN=thirty.daily.co

# Sentry Error Monitoring (optional, for error tracking and performance monitoring)
# Sentry DSN (Data Source Name) - public key for sending errors to Sentry
VITE_SENTRY_DSN=https://your-dsn@o123456.ingest.sentry.io/123456
# Sentry organization slug (found in Sentry organization settings)
SENTRY_ORG=your-org-slug
# Sentry project slug (found in Sentry project settings)
SENTRY_PROJECT=your-project-slug
# Sentry auth token (create in Sentry Settings > Auth Tokens with project:write scope)
SENTRY_AUTH_TOKEN=your-auth-token
# Current commit SHA for release tracking (usually set by CI/CD)
VITE_COMMIT_SHA=main
